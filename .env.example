# Demo works with no keys. auto prefers gateway, then DeepSeek, then direct Bedrock.
LLM_MODE=demo
# NUS-ISS organiser gateway (Ollama /api/chat, NOT direct Bedrock Converse).
# Set LLM_MODE=gateway after configuring the team's server-only credentials.
LLM_GATEWAY_URL=https://api.softwaresystems.app
LLM_GATEWAY_API_KEY=
LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# Official DeepSeek API: set LLM_MODE=deepseek after adding your server-only key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DATA_MODE=synthetic
# For sourced local snapshots, set DATA_MODE=file and use an ABSOLUTE JSON path.
# See docs/LIVE_SETUP_ZH.md. The file is reread on refresh and before approval.
LISTING_DATA_FILE=
# HDB historical transaction search (independent of DATA_MODE).
# Default: .propmatch-data/hdb-resales.sqlite; see docs/HDB_DATA_ZH.md.
HDB_RESALE_DB=
# Live mode: set LLM_MODE=bedrock (or auto) and a Bedrock API bearer token.
AWS_REGION=ap-southeast-1
AWS_BEARER_TOKEN_BEDROCK=
# Copy an enabled Claude Sonnet 4.5 model or inference-profile ID from your AWS account.
BEDROCK_MODEL_ID=
# Optional documented Converse-compatible HTTPS origin. Leave blank for regional AWS runtime.
BEDROCK_ENDPOINT=
# Node / Docker persistent storage; keep outside public/ and mount a durable volume.
# Leave blank for project-local .propmatch-sessions; Docker defaults to /app/storage.
SESSION_DIR=
NEXT_TELEMETRY_DISABLED=1
# Optional Caddy HTTPS deployment settings; set only for docker compose --profile https
DOMAIN=
# HTTPS access gate. Generate the bcrypt hash with `caddy hash-password`.
# Single-quote the hash in .env to preserve its literal dollar signs.
DEMO_AUTH_USER=judge
DEMO_AUTH_HASH=
# Full Git commit deployed; exposed as non-secret release identity by /api/status.
APP_COMMIT_SHA=
# Optional map provider settings. The default public endpoints need no paid key.
# OneMap search currently works unauthenticated; supply a token if your access requires one.
ONEMAP_ACCESS_TOKEN=
ONEMAP_SEARCH_URL=https://www.onemap.gov.sg/api/common/elastic/search
OSRM_BASE_URL=https://routing.openstreetmap.de
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Browser tile URL; attribution and normal browser caching must be preserved.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
