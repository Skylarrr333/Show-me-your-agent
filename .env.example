# Demo works with no keys. auto uses Bedrock only when a token is present.
LLM_MODE=demo
# Live mode: set LLM_MODE=bedrock (or auto) and a Bedrock API bearer token.
AWS_REGION=ap-southeast-1
AWS_BEARER_TOKEN_BEDROCK=
# Copy an enabled Claude Sonnet 4.5 model or inference-profile ID from your AWS account.
BEDROCK_MODEL_ID=
# Optional documented Converse-compatible HTTPS origin. Leave blank for regional AWS runtime.
BEDROCK_ENDPOINT=
# Node / Docker persistent storage; keep outside public/ and mount a durable volume.
SESSION_DIR=/app/storage
NEXT_TELEMETRY_DISABLED=1
# Optional Caddy HTTPS deployment settings; set only for docker compose --profile https
DOMAIN=
